---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  priority = false,
  widths = [480, 768, 1200, 1600],
  sizes = '(min-width: 1180px) 1180px, 100vw',
  class: className = '',
} = Astro.props;
---

<figure class:list={['my-10', className]}>
  <div class="border-rule overflow-hidden border">
    <Image
      {src}
      {alt}
      {widths}
      {sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="h-auto w-full"
    />
  </div>
  {caption && <figcaption class="label mt-3">{caption}</figcaption>}
</figure>

---
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { site } from '@/config';

const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="border-rule border-b print:hidden">
  <div class="page-width flex items-center justify-between gap-6 py-4">
    <a href="/" class="group flex items-center gap-3">
      <Logo size={32} class="shrink-0" />
      <span class="font-mono text-label uppercase">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-mono text-label uppercase transition-colors duration-150 hover:text-accent-dark',
            isActive(item.href) ? 'text-accent-dark' : 'text-muted',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/cv/"
        class="border-ink hover:bg-ink hover:text-paper inline-flex min-h-10 items-center gap-2 border px-3 font-mono text-label uppercase transition-colors duration-150"
      >
        CV
        <Icon name="arrow-up-right" size={13} />
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="border-rule text-ink inline-flex min-h-10 cursor-pointer list-none items-center gap-2 border px-3 font-mono text-label uppercase [&::-webkit-details-marker]:hidden">
        Menu
        <Icon name="menu" size={15} />
      </summary>
      <nav
        class="border-rule bg-paper absolute top-full right-0 z-50 mt-2 w-60 border p-2"
        aria-label="Mobile"
      >
        {site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex min-h-11 items-center px-3 font-mono text-label uppercase transition-colors hover:bg-paper-deep',
              isActive(item.href) ? 'text-accent-dark' : 'text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/cv/"
          class="border-rule mt-2 flex min-h-11 items-center justify-between border-t px-3 pt-2 font-mono text-label uppercase"
        >
          CV
          <Icon name="arrow-up-right" size={13} />
        </a>
      </nav>
    </details>
  </div>
</header>

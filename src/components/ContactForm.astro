---
import Icon from '@/components/Icon.astro';
import { site } from '@/config';

const configured = Boolean(site.turnstileSiteKey);
const inputClass =
  'border-rule bg-paper-raised focus:border-accent mt-2 min-h-11 w-full border px-3 py-2.5 text-body text-ink placeholder:text-muted/55 focus:outline-none';
---

<div class="border-rule border p-5 sm:p-7">
  {configured ? (
    <>
      <noscript>
        <p class="text-muted mb-4 text-small">
          The form needs JavaScript. You can email me directly at{' '}
          <a class="link-inline" href={`mailto:${site.email}`}>
            {site.email}
          </a>
          .
        </p>
      </noscript>

      <form data-contact-form data-endpoint="/api/contact/" class="space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="label">
              Name
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              maxlength="80"
              class={inputClass}
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="contact-email" class="label">
              Email
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              maxlength="254"
              class={inputClass}
              placeholder="you@example.com"
            />
          </div>
        </div>

        <div>
          <label for="contact-message" class="label">
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            minlength="10"
            maxlength="5000"
            rows="6"
            class={inputClass}
            placeholder="What are you building, and what role are you hiring for?"
          ></textarea>
        </div>

        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-theme="light"></div>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="bg-ink text-paper hover:bg-accent-dark inline-flex min-h-11 items-center justify-center gap-2 px-4 font-mono text-label uppercase transition-colors disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send message
            <Icon name="arrow-up-right" size={14} />
          </button>
          <p class="text-muted text-[11px] leading-relaxed">
            Your details are only used to reply.{' '}
            <a class="link-inline" href="/privacy/">
              Privacy
            </a>
            .
          </p>
        </div>

        <p data-contact-status role="status" aria-live="polite" class="min-h-5 text-small"></p>
      </form>
    </>
  ) : (
    <div>
      <p class="text-muted text-small">
        The form is being configured. In the meantime, email is the fastest way to reach me.
      </p>
      <a
        class="text-accent-dark mt-3 inline-flex min-h-11 items-center gap-2 font-mono text-label uppercase"
        href={`mailto:${site.email}`}
      >
        {site.email}
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  )}
</div>

<script>
  import { site } from '@/config';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const originalButton = button?.innerHTML ?? 'Send message';

    const setStatus = (message: string, tone: 'error' | 'success' | '') => {
      if (!status) return;
      status.textContent = message;
      status.className = [
        'min-h-5 text-small',
        tone === 'error' ? 'text-accent-dark' : '',
        tone === 'success' ? 'text-accent-dark' : '',
      ]
        .filter(Boolean)
        .join(' ');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        message: String(data.get('message') ?? ''),
        website: String(data.get('website') ?? ''),
        token: String(data.get('cf-turnstile-response') ?? ''),
      };

      setStatus('', '');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }

      try {
        const response = await fetch(form.dataset.endpoint ?? '/api/contact/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = (await response.json().catch(() => ({}))) as { error?: string };

        if (!response.ok) {
          throw new Error(result.error ?? 'Request failed');
        }

        form.reset();
        (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
        setStatus('Thanks, your message has been sent. I will reply by email.', 'success');
      } catch {
        if (status) {
          status.innerHTML = `Something went wrong. Email me directly at <a class="link-inline" href="mailto:${site.email}">${site.email}</a>.`;
          status.className = 'min-h-5 text-small text-accent-dark';
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.innerHTML = originalButton;
        }
      }
    });
  }
</script>

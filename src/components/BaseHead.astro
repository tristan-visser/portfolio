---
import { site } from '@/config';
import { absoluteUrl, type JsonLd } from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: JsonLd[];
}

const {
  title,
  description = site.description,
  canonical = absoluteUrl(Astro.url.pathname),
  ogImage = absoluteUrl('/og.png'),
  noindex = false,
  schema = [],
} = Astro.props;

const shouldNoindex = noindex || import.meta.env.SITE_NOINDEX === 'true';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta
  name="robots"
  content={shouldNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
/>

<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="mask-icon" href="/mask-icon.svg" color="#b4432a" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#f3eee5" />
<meta name="color-scheme" content="light dark" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="en_ZA" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Tristan Visser, computer science graduate and full-stack developer"
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta
  name="twitter:image:alt"
  content="Tristan Visser, computer science graduate and full-stack developer"
/>

{schema.map((item) => (
  <script type="application/ld+json" set:html={JSON.stringify(item)} />
))}

<script is:inline>
  (() => {
    const root = document.documentElement;
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      // Storage can be unavailable; fall back to the system preference.
    }
    const dark = stored
      ? stored === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'dark' : 'light';
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', dark ? '#171614' : '#f3eee5');
  })();
</script>

{site.analyticsToken && <script is:inline define:vars={{ analyticsToken: site.analyticsToken }}>
  (() => {
    if (
      !analyticsToken ||
      window.location.hostname !== 'tristanvisser.co.za' ||
      window.location.pathname.startsWith('/cv/print/')
    ) {
      return;
    }
    const beacon = document.createElement('script');
    beacon.type = 'module';
    beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    beacon.setAttribute('data-cf-beacon', JSON.stringify({ token: analyticsToken }));
    document.head.appendChild(beacon);
  })();
</script>}

<slot />

---
import { site } from '@/config';
import { absoluteUrl, type JsonLd } from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: JsonLd[];
}

const {
  title,
  description = site.description,
  canonical = absoluteUrl(Astro.url.pathname),
  ogImage = absoluteUrl('/og.png'),
  noindex = false,
  schema = [],
} = Astro.props;

const shouldNoindex = noindex || import.meta.env.SITE_NOINDEX === 'true';
const showAnalytics = Boolean(site.analyticsToken) && Astro.url.pathname !== '/cv/print/';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta
  name="robots"
  content={shouldNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
/>

<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="mask-icon" href="/mask-icon.svg" color="#b4432a" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#f3eee5" />
<meta name="color-scheme" content="light dark" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="en_ZA" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.title}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{schema.map((item) => (
  <script type="application/ld+json" set:html={JSON.stringify(item)} />
))}

<script is:inline>
  (() => {
    const root = document.documentElement;
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      // Storage can be unavailable; fall back to the system preference.
    }
    const dark = stored
      ? stored === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'dark' : 'light';
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', dark ? '#171614' : '#f3eee5');
  })();
</script>

{showAnalytics && site.analyticsToken && (
  <script
    is:inline
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
  ></script>
)}

<slot />

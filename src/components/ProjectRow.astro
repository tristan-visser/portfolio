---
import Icon from '@/components/Icon.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { projectPath, type Project } from '@/lib/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<a
  href={projectPath(project)}
  class="group border-rule hover:bg-ink/[0.035] grid grid-cols-[32px_minmax(0,1fr)_20px] items-start gap-x-4 gap-y-2 border-b py-6 transition-colors lg:grid-cols-[44px_minmax(0,1fr)_minmax(160px,0.45fr)_60px_22px] lg:gap-x-6 lg:py-7"
>
  <span class="text-accent pt-1 font-mono text-label">{number}</span>

  <div class="min-w-0">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="font-serif text-display-md text-ink font-normal">{project.data.title}</h3>
      <StatusBadge status={project.data.status} />
    </div>
    <p class="text-muted mt-2 max-w-[58ch] text-small">{project.data.summary}</p>
  </div>

  <div class="text-muted col-start-2 row-start-2 font-mono text-[10px] leading-relaxed tracking-[0.05em] uppercase lg:col-start-3 lg:row-start-1 lg:border-l lg:border-rule lg:pl-6 lg:pt-1">
    {project.data.stack.join(' · ')}
  </div>

  <span class="text-muted col-start-2 row-start-3 font-mono text-label lg:col-start-4 lg:row-start-1 lg:pt-1">
    {project.data.year}
  </span>

  <span class="text-accent col-start-3 row-start-1 pt-0.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 lg:col-start-5">
    <Icon name="arrow-up-right" size={18} />
  </span>
</a>

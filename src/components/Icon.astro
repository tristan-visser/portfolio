---
export type IconName =
  | 'arrow-up-right'
  | 'arrow-right'
  | 'arrow-down'
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'copy'
  | 'check'
  | 'menu'
  | 'close'
  | 'external'
  | 'sun'
  | 'moon';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  'aria-hidden': 'true' as const,
  focusable: 'false' as const,
  class: className,
};
---

{name === 'arrow-up-right' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <path d="M7 17 17 7M9 7h8v8" />
  </svg>
)}
{name === 'arrow-right' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <path d="M4 12h15M13 6l6 6-6 6" />
  </svg>
)}
{name === 'arrow-down' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <path d="M12 4v15M6 13l6 6 6-6" />
  </svg>
)}
{name === 'external' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <path d="M14 4h6v6M20 4 10 14M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
  </svg>
)}
{name === 'github' && (
  <svg {...common} fill="currentColor">
    <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.17c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.3-.52-1.48.11-3.08 0 0 .97-.31 3.18 1.19a11 11 0 0 1 5.79 0c2.2-1.5 3.17-1.19 3.17-1.19.64 1.6.24 2.78.12 3.08.75.81 1.2 1.84 1.2 3.11 0 4.45-2.71 5.42-5.29 5.71.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
  </svg>
)}
{name === 'linkedin' && (
  <svg {...common} fill="currentColor">
    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21h-4V9Z" />
  </svg>
)}
{name === 'mail' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6">
    <rect x="3" y="5" width="18" height="14" rx="1" />
    <path d="m3.5 6 8.5 7 8.5-7" />
  </svg>
)}
{name === 'copy' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6">
    <rect x="8" y="8" width="11" height="12" rx="1" />
    <path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" />
  </svg>
)}
{name === 'check' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
    <path d="m4 12 5 5L20 6" />
  </svg>
)}
{name === 'menu' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
)}
{name === 'close' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <path d="m6 6 12 12M18 6 6 18" />
  </svg>
)}
{name === 'sun' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
)}
{name === 'moon' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
  </svg>
)}

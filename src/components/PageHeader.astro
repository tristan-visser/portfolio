---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<header class="border-rule border-b">
  <div class="page-width py-12 md:py-16">
    {eyebrow && <p class="label">{eyebrow}</p>}
    <h1 class="mt-3 max-w-[18ch] font-serif text-display-lg font-normal">{title}</h1>
    {intro && <p class="text-ink-soft mt-5 max-w-[62ch] text-lg leading-relaxed">{intro}</p>}
  </div>
</header>

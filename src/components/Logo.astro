---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" fill="#171614"></rect>
  <rect x="12" y="12" width="40" height="6" fill="#f3eee5"></rect>
  <rect x="29" y="12" width="6" height="24" fill="#f3eee5"></rect>
  <polygon points="29,34 35,34 19,52 13,52" fill="#f3eee5"></polygon>
  <polygon points="29,34 35,34 51,52 45,52" fill="#f3eee5"></polygon>
</svg>

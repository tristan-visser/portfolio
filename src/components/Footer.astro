---
import Icon from '@/components/Icon.astro';
import { site, socialLinks } from '@/config';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper print:hidden">
  <div class="page-width py-16 md:py-20">
    <p class="label text-paper/70">Contact</p>
    <h2 class="mt-4 max-w-[14ch] font-serif text-display-lg font-normal text-paper">
      Let's build something useful.
    </h2>
    <a
      href={`mailto:${site.email}`}
      class="mt-6 inline-block border-b border-paper/35 pb-1 font-mono text-base transition-colors hover:border-accent hover:text-accent"
    >
      {site.email}
    </a>

    <div class="mt-14 grid gap-10 border-t border-paper/15 pt-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="label text-paper/65">Pages</p>
        <ul class="mt-4 space-y-2 text-small">
          {[...site.nav, { label: 'CV', href: '/cv/' }].map((item) => (
            <li>
              <a class="transition-colors hover:text-accent" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a class="transition-colors hover:text-accent" href="/privacy/">
              Privacy
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="label text-paper/65">Elsewhere</p>
        <ul class="mt-4 space-y-2 text-small">
          {socialLinks.map((link) => (
            <li>
              <a
                class="inline-flex items-center gap-2 transition-colors hover:text-accent"
                href={link.href}
                rel={link.icon === 'mail' ? undefined : 'me noopener'}
                target={link.icon === 'mail' ? undefined : '_blank'}
              >
                <Icon name={link.icon} size={14} />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="label text-paper/65">Based in</p>
        <p class="mt-4 text-small text-paper/85">{site.location}</p>
        <p class="mt-2 text-small text-paper/70">{site.availability}</p>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-paper/15 pt-5 font-mono text-[10px] tracking-[0.06em] text-paper/65 uppercase sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.name}. All rights reserved.
      </p>
      <p>
        Built with Astro. Deployed on Cloudflare.{' '}
        <a
          class="transition-colors hover:text-accent"
          href={site.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Source
        </a>
        . No tracking cookies.
      </p>
    </div>
  </div>
</footer>

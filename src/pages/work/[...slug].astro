---
import { render, type CollectionEntry } from 'astro:content';
import ArrowLink from '@/components/ArrowLink.astro';
import ButtonLink from '@/components/ButtonLink.astro';
import Callout from '@/components/Callout.astro';
import Figure from '@/components/Figure.astro';
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedProjects, projectPath } from '@/lib/projects';
import {
  absoluteUrl,
  breadcrumbSchema,
  pageTitle,
  personSchema,
  projectSchema,
  websiteSchema,
} from '@/lib/seo';

type Props = { project: CollectionEntry<'projects'> };

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as Props;
const { Content } = await render(project);

const allProjects = await getPublishedProjects();
const currentIndex = allProjects.findIndex((item) => item.id === project.id);
const nextProject =
  allProjects.length > 1 ? allProjects[(currentIndex + 1) % allProjects.length] : undefined;

const canonical = absoluteUrl(projectPath(project));
const description = project.data.summary;

const schema = [
  personSchema(),
  websiteSchema(),
  projectSchema(project, canonical),
  breadcrumbSchema([
    { name: 'Work', href: '/work/' },
    { name: project.data.title, href: projectPath(project) },
  ]),
];

const meta = [
  { label: 'Role', value: project.data.role },
  { label: 'Year', value: String(project.data.year) },
  { label: 'Timeline', value: project.data.timeline },
  ...(project.data.team ? [{ label: 'Team', value: project.data.team }] : []),
  { label: 'Stack', value: project.data.stack.join(', ') },
];
---

<BaseLayout
  title={pageTitle(project.data.title)}
  {description}
  {canonical}
  noindex={project.data.placeholder}
  {schema}
>
  <section class="border-rule border-b">
    <div class="page-width py-10 md:py-14">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <SectionLabel index={String(project.data.year)} label="Case study" />
        <StatusBadge status={project.data.status} />
      </div>

      <h1 class="mt-5 max-w-[18ch] font-serif text-display-lg font-normal">{project.data.title}</h1>
      <p class="text-ink-soft mt-5 max-w-[62ch] text-lg leading-relaxed">{project.data.summary}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        {project.data.liveUrl && (
          <ButtonLink href={project.data.liveUrl} label="Live site" external />
        )}
        {project.data.repoUrl && (
          <ButtonLink
            href={project.data.repoUrl}
            label="Source code"
            variant="secondary"
            external
          />
        )}
        <ArrowLink href="/work/" label="Back to work" />
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="page-width grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-16">
      <div class="min-w-0">
        {project.data.placeholder && (
          <Callout type="warning" title="Placeholder case study">
            <p>
              This page is here to test the layout. It will be replaced with a real project before
              the site is published. The production build refuses to ship placeholder projects.
            </p>
          </Callout>
        )}

        {project.data.cover && (
          <Figure
            src={project.data.cover.src}
            alt={project.data.cover.alt}
            caption={`${project.data.title} — ${project.data.year}`}
            priority
          />
        )}

        <Prose>
          <Content />
        </Prose>
      </div>

      <aside class="lg:sticky lg:top-8 lg:self-start">
        <p class="label">Project details</p>
        <dl class="border-rule mt-4 border-t">
          {meta.map((item) => (
            <div class="border-rule grid grid-cols-[80px_1fr] gap-3 border-b py-3">
              <dt class="label pt-0.5">{item.label}</dt>
              <dd class="text-small text-ink-soft">{item.value}</dd>
            </div>
          ))}
          <div class="border-rule grid grid-cols-[80px_1fr] gap-3 border-b py-3">
            <dt class="label pt-0.5">Status</dt>
            <dd class="text-small text-ink-soft">
              <StatusBadge status={project.data.status} />
            </dd>
          </div>
        </dl>

        <div class="mt-8">
          <p class="label">Links</p>
          <ul class="mt-3 space-y-2 text-small">
            {project.data.liveUrl && (
              <li>
                <a
                  class="link-inline inline-flex items-center gap-1.5"
                  href={project.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live site
                  <Icon name="arrow-up-right" size={13} />
                </a>
              </li>
            )}
            {project.data.repoUrl && (
              <li>
                <a
                  class="link-inline inline-flex items-center gap-1.5"
                  href={project.data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Source code
                  <Icon name="arrow-up-right" size={13} />
                </a>
              </li>
            )}
            {!project.data.liveUrl && !project.data.repoUrl && (
              <li class="text-muted">Links are being added.</li>
            )}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {nextProject && (
    <section class="border-rule border-t py-10">
      <div class="page-width flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="label">Next project</p>
          <a class="group mt-2 inline-flex items-center gap-3" href={projectPath(nextProject)}>
            <h2 class="font-serif text-display-md font-normal">{nextProject.data.title}</h2>
            <Icon
              name="arrow-up-right"
              size={20}
              class="text-accent transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>
        <ArrowLink href="/work/" label="All work" />
      </div>
    </section>
  )}
</BaseLayout>

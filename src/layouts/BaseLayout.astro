---
import { Font } from 'astro:assets';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { site } from '@/config';
import type { JsonLd } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: JsonLd[];
  /** Render only the page content, without site header/footer. Used by the PDF sheet. */
  bare?: boolean;
}

const { title, description, canonical, ogImage, noindex, schema, bare = false } = Astro.props;
---

<!doctype html>
<html lang={site.lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-newsreader" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-source-sans" preload={[{ weight: 400, style: 'normal' }]} />
    <BaseHead {title} {description} {canonical} {ogImage} {noindex} {schema} />
    <slot name="head" />
  </head>
  <body class:list={[bare && 'print-sheet-body']}>
    {!bare && (
      <a
        href="#main"
        class="focus:bg-ink focus:text-paper sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:font-mono focus:text-label focus:uppercase print:hidden"
      >
        Skip to content
      </a>
    )}

    {!bare && <Header />}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {!bare && <Footer />}

    <slot name="scripts" />
  </body>
</html>

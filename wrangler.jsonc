{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tristanvisser",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "vars": {
    "CONTACT_TO": "contact@tristanvisser.co.za",
    "CONTACT_FROM": "website@tristanvisser.co.za",
    "ALLOWED_ORIGIN": "https://tristanvisser.co.za,http://localhost:4322,https://tristanvisser.tristanvisser.workers.dev",
  },
}

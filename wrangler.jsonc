{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tristanvisser",
  "workers_dev": false,
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "vars": {
    "CONTACT_TO": "hello@tristanvisser.co.za",
    "CONTACT_FROM": "website@tristanvisser.co.za",
    "ALLOWED_ORIGIN": "https://tristanvisser.co.za,https://www.tristanvisser.co.za",
  },
}
